# Copy to .env and fill in. .env is git-ignored and auto-loaded on startup (springboot4-dotenv).

# Local dev: docker compose exposes postgres on 5433 (5432 is taken by another project)
DB_URL=jdbc:postgresql://localhost:5433/price_tracker
DB_USERNAME=dev
DB_PASSWORD=devpass

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: override check schedule (spring cron, default: 08:00 and 20:00 UTC)
#TRACKER_CHECK_CRON=0 0 8,20 * * *
